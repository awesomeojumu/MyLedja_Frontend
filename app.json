{
  "expo": {
    "name": "MyLedja",
    "slug": "myledja",
    "scheme": "myledja",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planexi.myledja",
      "infoPlist": {
        "NSFaceIDUsageDescription": "MyLedja uses Face ID to unlock the app when app lock is on."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1E3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.planexi.myledja"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MyLedja uses Face ID to unlock the app when app lock is on."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "MyLedja uses your contacts so you can pick who you lent to or borrowed from."
        }
      ]
    ]
  }
}
