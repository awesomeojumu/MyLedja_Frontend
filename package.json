{
  "name": "myledja-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint -- --max-warnings=0",
    "typecheck": "node --stack-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx src/lib/config.test.ts && tsx src/lib/tab-route.test.ts && tsx src/lib/nav-mode.test.ts && tsx src/lib/screen-catalog.test.ts && tsx src/design/contrast.test.ts && tsx src/features/auth-onboarding/__tests__/auth-flow.test.ts && tsx src/features/auth-onboarding/__tests__/otp.test.ts && tsx src/features/dashboard/__tests__/dummy-data.test.ts && tsx src/features/transactions/__tests__/add-draft.test.ts && tsx src/features/boundaries.test.ts",
    "build": "expo export --platform web --output-dir dist",
    "apptest": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.29",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^0.460.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
