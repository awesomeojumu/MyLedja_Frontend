{
  "name": "myledja-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint -- --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/config.test.ts",
    "build": "expo export --platform web --output-dir dist",
    "apptest": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
