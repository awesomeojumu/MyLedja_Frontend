{
  "name": "myledja-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "expo start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "expo export --platform web",
    "cases:check": "node scripts/cases-check.mjs",
    "api:sync": "node scripts/api-sync.mjs",
    "api:check": "node scripts/api-sync.mjs --check",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run cases:check && npm run api:check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "expo": "58.0.20",
    "expo-asset": "~58.0.19",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.10",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.27",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "58.0.4",
    "lucide-react-native": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "serve": "14.2.6",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
